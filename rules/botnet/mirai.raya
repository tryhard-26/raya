rule mirai_botnet : linux botnet malware {
    meta:
        author = "Raya Research Team"
        description = "Detects Mirai IoT botnet artifacts, killall commands, watchdog terminations, and attack commands"
        severity = "critical"
        technique = "T1059.004"
        reference = "https://attack.mitre.org/software/S0286/"

    strings:
        $cmd1 = "/bin/busybox killall" ascii nocase
        $cmd2 = "/dev/watchdog" ascii
        $cmd3 = "/dev/misc/watchdog" ascii
        $scan = "POST /cdn-cgi/" ascii
        $dvr  = "dvrHelper" ascii
        $telnet = "/bin/busybox telnetd" ascii nocase

    condition:
        elf.is_elf and (
            ($cmd1 and ($cmd2 or $cmd3))
            or ($dvr and ($cmd1 or $telnet))
            or (2 of ($cmd1, $cmd2, $cmd3, $scan, $dvr, $telnet))
        )
}
