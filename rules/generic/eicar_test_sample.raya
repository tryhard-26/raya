rule eicar_standard_test_file : generic test {
    meta:
        author = "Raya Research Team"
        description = "Detects the industry standard EICAR anti-malware test file pattern"
        severity = "info"
        reference = "https://www.eicar.org/download-anti-malware-testfile/"

    strings:
        $eicar = "X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*" ascii

    condition:
        $eicar
}
