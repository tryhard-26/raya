rule cfg_flattening_obfuscation : evasion obfuscation {
    meta:
        author = "Raya Research Team"
        description = "Detects Control Flow Flattening (CFF) state machine obfuscation"
        severity = "medium"
        technique = "T1027"
        reference = "https://attack.mitre.org/techniques/T1027/"

    condition:
        cfg.is_flattened
}
