# Safety & Hygiene: Prevent large binaries and live malware in Git
samples/malware/*
!samples/malware/.gitkeep
samples/benign/*
!samples/benign/.gitkeep
!samples/manifest.json
*.infected
*.malware
*.rc
tests/fixtures/*.exe
tests/fixtures/*.elf
tests/fixtures/*.dat
!tests/fixtures/clean_application.exe
!tests/fixtures/corrupted_pe.exe
!tests/fixtures/sample_injection.exe
!tests/fixtures/high_entropy_benign.dat

